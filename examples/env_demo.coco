# Reads its settings from the run environment: `env` in flows, `self.env` in steps.
# Try: coco run examples/env_demo.coco main -s path=/users --env examples/dev.env.json
package env_demo

step build_url(string path)(string url):
    self.log("building a url for", self.env.user)
    self.log("api settings:", self.env.api)
    return self.env.api.base_url + path

flow main(string path)(string url, int retries):
    string u
    int r
    u = build_url(path)
    r = env.get("retries", 3)
    if env.api.verbose:
        u = u + "?verbose=1"
    return u, r
