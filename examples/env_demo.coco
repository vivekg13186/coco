"""Reads its settings from the run environment with `env`, in flows and in steps.

Try: coco run examples/env_demo.coco main -s path=/users --env examples/dev.env.json
"""
from coco import step, flow, log, env


@step
def build_url(path: str) -> str:
    log("building a url for", env.user)
    log("api settings:", env.api)
    return env.api.base_url + path


@flow
def main(path: str = "/") -> {"url": str, "retries": int}:
    url = build_url(path)
    retries = env.get("retries", 3)
    if env.api.verbose:
        url = url + "?verbose=1"
    return {"url": url, "retries": retries}
