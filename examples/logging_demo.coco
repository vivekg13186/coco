"""Console-style logging: log / info / warn / error / debug take any values; log_table shows rows."""
from coco import step, flow, log, info, warn, error, debug, log_table


class Order:
    id: str
    customer: str
    total: float
    paid: bool


@step
def load_orders(n: int) -> list[Order]:
    customers = ["ada", "bob", "cy"]
    orders = [Order(id=f"A{100 + i}", customer=customers[i % 3], total=round((19.5 * (i + 1)) % 97, 2),
                    paid=i % 4 != 0) for i in range(n)]
    log("loaded", len(orders), "orders; first:", orders[0])
    log_table(orders)
    return orders


@step
def check(orders: list[Order]) -> int:
    late = [o.id for o in orders if not o.paid]
    if late:
        warn(len(late), "unpaid orders:", late)
    totals = {c: round(sum(o.total for o in orders if o.customer == c), 2) for c in ("ada", "bob", "cy")}
    debug("totals by customer", totals)
    log_table(totals)
    info("summary", {"count": len(orders), "unpaid": len(late), "flags": {"ok": not late, "ids": late[:3]}})
    if len(late) > len(orders) // 2:
        error("more than half of the orders are unpaid")
    return len(late)


@flow
def main(n: int = 8) -> {"unpaid": int}:
    orders = load_orders(n)
    unpaid = check(orders)
    log("done:", unpaid, "unpaid")
    return {"unpaid": unpaid}
