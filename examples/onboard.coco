# Onboard a team: enrich each member, count changes, welcome changed members.
package onboard

class Person:
    string name
    int age = 0

class Team:
    string title
    Person members[]

step enrich(Person p, string source)(Person out, boolean changed):
    self.log("fetching", p.name)
    data = {"age": 30 + len(p.name), "source": source}  # stand-in for an API call
    self.log("api response:", data)
    changed = p.age != data["age"]
    if changed:
        self.warn("age changed for", p.name, p.age, "->", data["age"])
    p.age = data["age"]
    return p, changed

step report(Team t)():
    self.log_table(t.members, ["name", "age"])

step send_mail(string to, string subject)():
    print(f"mail to {to}: {subject}")

flow notify_member(Person p)():
    send_mail(p.name, "Welcome, " + p.name)

flow onboard(Team t, int limit)(int processed, float avg_age):
    int count, n, total
    Person p
    boolean changed
    count = 0
    total = 0
    n = min(len(t.members), limit)
    for i in range(0, n, 1):
        (p, changed) = enrich(t.members[i], "https://api.example")
        total = total + p.age
        if changed:
            count = count + 1
            notify_member(p)
    report(t)
    if n > 0:
        return count, total / n
    else:
        return count, 0.0
