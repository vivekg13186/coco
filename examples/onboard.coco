"""Onboard a team: enrich each member, count changes, welcome changed members."""
from coco import step, flow, log, warn, log_table


class Person:
    name: str
    age: int = 0


class Team:
    title: str
    members: list[Person]


@step
def enrich(p: Person, source: str) -> {"person": Person, "changed": bool}:
    log("fetching", p.name)
    data = {"age": 30 + len(p.name), "source": source}  # stand-in for an API call
    log("api response:", data)
    changed = p.age != data["age"]
    if changed:
        warn("age changed for", p.name, p.age, "->", data["age"])
    p.age = data["age"]
    return {"person": p, "changed": changed}


@step
def report(t: Team) -> None:
    log_table(t.members, ["name", "age"])


@step
def send_mail(to: str, subject: str) -> None:
    print(f"mail to {to}: {subject}")


@flow
def notify_member(p: Person) -> None:
    send_mail(p.name, "Welcome, " + p.name)


@flow
def onboard(t: Team, limit: int = 10) -> {"processed": int, "avg_age": float}:
    count = 0
    total = 0
    n = min(len(t.members), limit)
    for member in t.members[:n]:
        p, changed = enrich(member, "https://api.example")
        total = total + p.age
        if changed:
            count = count + 1
            notify_member(p)
    report(t)
    if n > 0:
        return {"processed": count, "avg_age": total / n}
    else:
        return {"processed": count, "avg_age": 0.0}
