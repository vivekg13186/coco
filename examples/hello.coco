"""The smallest workflow: one step, one flow."""
import math

from coco import step, flow, log


@step
def greet(name: str, times: int = 2) -> tuple[str, float]:
    log("greeting", name, times, "time(s)")
    return ", ".join([f"Hello, {name}!"] * times), math.sqrt(times)


@flow
def main(name: str = "world") -> str:
    message, root = greet(name)
    return message
